# MySQL 連線設定
# 密碼可以含 @ : / ? # 等特殊字元，程式會自動處理，不需要跳脫或加引號
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=honey_web

# JWT 設定（上線務必換掉）
SECRET_KEY=change-this-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# 允許的前端來源
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# 建立初始管理員帳號（執行 seed.py 時使用）
ADMIN_EMAIL=admin@honeyshop.com
ADMIN_PASSWORD=admin1234
ADMIN_NAME=網站管理員

# ---------------- 背景工作 ----------------
# 啟動時自動建表／補欄位，以及每小時清理逾期未付款訂單。
# 平常保持 true。跑多個副本時，可以只讓其中一個開著，避免重複清理。
ENABLE_BACKGROUND_JOBS=true

# ---------------- 綠界 ECPay ----------------
# stage = 測試環境（用綠界公開的測試金鑰，不會真的扣款）
# production = 正式環境
ECPAY_ENV=stage

# 物流可以跟金流分開切換。
# 綠界的物流與金流是分開審核的，物流常常先通過 ——
# 物流一過就可以先用「貨到付款」開賣，不必等金流。
# 留空 = 跟著 ECPAY_ENV 走。
ECPAY_LOGISTICS_ENV=

# 金流（全方位金流）
#
# 下面這一組是綠界「公開的測試金鑰」，誰都查得到。
# 切正式時**一定要一起換掉** —— 只改 ECPAY_ENV 不換金鑰的話，
# 客人會被帶到正式付款頁，然後每一筆都因為檢查碼不符而失敗。
# 系統認得出這幾個值，沒換之前會維持線上付款關閉並在後台說明原因。
#
# 自己的那一組在：綠界廠商後台 → 系統開發管理 → 系統介接設定（選正式環境）
ECPAY_MERCHANT_ID=3002607
ECPAY_HASH_KEY=pwFHCqoQZGmho4w6
ECPAY_HASH_IV=EkRm7iFT261dpevs

# 物流 C2C 店到店（7-ELEVEN 交貨便、全家店到店）
ECPAY_C2C_MERCHANT_ID=2000933
ECPAY_C2C_HASH_KEY=XBERn1YOvpM9nfZc
ECPAY_C2C_HASH_IV=h1ONHk4P4yqbl5LK

# 物流 宅配（黑貓、中華郵政）
ECPAY_HOME_MERCHANT_ID=2000132
ECPAY_HOME_HASH_KEY=5294y06JbISpM5x9
ECPAY_HOME_HASH_IV=v77hoKGq4kWxNNIS

# 綠界的「付款結果」與「物流狀態」通知會打到這個網址，
# 必須是外部連得到的公開網址，且綠界只支援 80 / 443 埠。
# 本機開發可用 ngrok：ngrok http 8000，再把網址填在這裡。
# 若不設定，選門市、下單、付款、建立物流單仍可正常運作，
# 只是收不到自動通知，可在後台用「向綠界查詢付款狀態」補回。
BACKEND_BASE_URL=http://127.0.0.1:8000
FRONTEND_BASE_URL=http://localhost:5173

# ---------------- 應用環境 ----------------
# development = 開發（未設定 SMTP 時，驗證連結會直接顯示在畫面上方便測試）
# production  = 正式（絕不外洩驗證連結）
APP_ENV=development

# ---------------- 寄信設定（SMTP）----------------
# 留空 = 不實際寄信，信件會存成 HTML 放在 backend/outbox/，用瀏覽器打開就能看
# Gmail 範例（需先到 Google 帳號開啟兩步驟驗證，再產生「應用程式密碼」）：
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=你的帳號@gmail.com
#   SMTP_PASSWORD=十六碼的應用程式密碼（不是 Gmail 登入密碼）
#   SMTP_FROM=你的帳號@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_FROM_NAME=蜂蜜工坊
SMTP_TLS=true
SMTP_SSL=false

# 連結有效時間與寄信冷卻
VERIFY_TOKEN_HOURS=24
RESET_TOKEN_HOURS=1
EMAIL_RESEND_COOLDOWN=60
